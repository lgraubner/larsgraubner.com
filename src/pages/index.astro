---
import { Image } from "astro:assets";
import portrait from "../assets/semi_professional_square.jpg";
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";

const title = "Lars Graubner - Senior Software Engineer";
const description =
  "Lars Graubner is a Senior Software Engineer who turns complex product problems into reliable web systems.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: Astro.site,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#person", Astro.site),
    name: "Lars Graubner",
    jobTitle: "Senior Software Engineer",
    description,
    url: Astro.site,
    image: new URL("/social-portrait.jpg", Astro.site),
    sameAs: [
      "https://github.com/lgraubner/",
      "https://www.linkedin.com/in/larsgraubner/",
      "https://x.com/larsgraubner",
    ],
  },
};
---

<Layout {title} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-150">
    <header class="flex items-center gap-3 sm:gap-4">
      <Image
        class="mt-px block size-9 object-cover sm:size-11"
        src={portrait}
        alt="Portrait of Lars Graubner"
        width={44}
        height={44}
        widths={[36, 44, 72, 96]}
        sizes="(min-width: 640px) 44px, 36px"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <h1
        class="font-serif text-4xl leading-none font-semibold tracking-[-0.01em] sm:text-6xl"
      >
        Lars Graubner
      </h1>
    </header>

    <p class="mt-14 text-xl leading-relaxed font-[350] sm:text-2xl">
      I’m a Senior Software Engineer based in Lübeck, Germany. I turn complex
      product problems into reliable web systems.
    </p>

    <p class="mt-10 text-lg leading-[1.65] font-[350] sm:text-xl">
      At <Link href="https://www.shinefour.de/">Shinefour</Link>, I help clients
      make technical decisions and deliver web products across frontend and
      backend. I also build and operate <Link href="https://orbitpush.run/"
        >OrbitPush</Link
      >, a hosting platform for static websites.
    </p>

    <p class="mt-[1.65em] text-lg leading-[1.65] font-[350] sm:text-xl">
      You can also find me on <Link
        rel="me"
        href="https://github.com/lgraubner/">GitHub</Link
      >, <Link rel="me" href="https://www.linkedin.com/in/larsgraubner/"
        >LinkedIn</Link
      >, and <Link rel="me" href="https://x.com/larsgraubner">X</Link>, or
      contact me by <Link href="mailto:hello@larsgraubner.com">email</Link>.
    </p>
  </div>
</Layout>
